{
  "index_patterns": ["api-ventes-logs-*"],
  "priority": 200,
  "template": {
    "settings": { "number_of_shards": 1, "number_of_replicas": 0 },
    "mappings": {
      "dynamic_templates": [
        { "chaines": { "match_mapping_type": "string", "mapping": { "type": "keyword", "ignore_above": 1024 } } }
      ],
      "properties": {
        "@timestamp": { "type": "date" },
        "level": { "type": "keyword" },
        "message": { "type": "text" },
        "service": { "type": "keyword" },
        "environnement": { "type": "keyword" },
        "type": { "type": "keyword" },
        "request_id": { "type": "keyword" },
        "categorie_statut": { "type": "keyword" },
        "reference": { "type": "keyword" },
        "action": { "type": "keyword" },
        "http": {
          "properties": {
            "methode": { "type": "keyword" },
            "url": { "type": "keyword" },
            "route": { "type": "keyword" },
            "statut": { "type": "integer" },
            "duree_ms": { "type": "float" },
            "taille_reponse": { "type": "long" },
            "ip": { "type": "keyword" },
            "user_agent": { "type": "keyword" }
          }
        },
        "erreur": {
          "properties": {
            "code": { "type": "keyword" },
            "nom": { "type": "keyword" },
            "message": { "type": "text", "fields": { "brut": { "type": "keyword", "ignore_above": 512 } } },
            "pile": { "type": "text" }
          }
        }
      }
    }
  }
}
