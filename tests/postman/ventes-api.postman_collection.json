    {
      "name": "03 - Cycle de vie d'une vente (CRUD)",
      "item": [
        {
          "name": "Creer une vente",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Statut 201\", () => pm.response.to.have.status(201));",
                  "const v = pm.response.json();",
                  "pm.test(\"Montants calcules par le serveur\", () => {",
                  "  pm.expect(v.montant_brut).to.eql(19500);",
                  "  pm.expect(v.montant_remise).to.eql(975);",
                  "  pm.expect(v.montant_net).to.eql(18525);",
                  "});",
                  "pm.test(\"Reference generee et en-tete Location\", () => {",
                  "  pm.expect(v.reference).to.match(/^VTE-20261015-[A-F0-9]{6}$/);",
                  "  pm.expect(pm.response.headers.get(\"Location\")).to.eql(\"/api/v1/ventes/\" + v.reference);",
                  "});",
                  "pm.test(\"Source API, version 1\", () => pm.expect(v).to.include({ source: \"API\", version: 1, statut: \"VALIDEE\" }));",
                  "pm.collectionVariables.set(\"reference_creee\", v.reference);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/ventes",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "ventes"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"date_vente\": \"2026-10-15T10:30:00Z\",\n  \"code_client\": \"CLI-0012\",\n  \"produit\": {\n    \"code\": \"PRD-002\",\n    \"libelle\": \"Huile végétale 5 L\",\n    \"categorie\": \"Alimentation\"\n  },\n  \"quantite\": 3,\n  \"prix_unitaire\": 6500,\n  \"remise_pct\": 5,\n  \"mode_paiement\": \"MOBILE_MONEY\",\n  \"canal\": \"BOUTIQUE\",\n  \"point_vente\": \"OUAGA-CENTRE\"\n}"
            }
          }
        },
        {
          "name": "Consulter la vente creee",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Statut 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"Bonne vente\", () => pm.expect(pm.response.json().reference).to.eql(pm.collectionVariables.get(\"reference_creee\")));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/ventes/{{reference_creee}}",
              "host": [
                "{{baseUrl}}"
