              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Statut 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"Remplacement complet et version 2\", () => {",
                  "  const v = pm.response.json();",
                  "  pm.expect(v).to.include({ quantite: 4, remise_pct: 0, montant_net: 26000, version: 2 });",
                  "  pm.expect(v.point_vente).to.be.null;",
                  "});"
                ]
