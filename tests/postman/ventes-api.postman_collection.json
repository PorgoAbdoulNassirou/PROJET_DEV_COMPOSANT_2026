    {
      "name": "02 - Consultation des ventes",
      "item": [
        {
          "name": "Lister les ventes (page 1)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Statut 200\", () => pm.response.to.have.status(200));",
                  "const corps = pm.response.json();",
                  "pm.test(\"5 ventes et pagination\", () => {",
                  "  pm.expect(corps.donnees).to.have.lengthOf(5);",
                  "  pm.expect(corps.pagination).to.include({ page: 1, limite: 5 });",
                  "  pm.expect(corps.pagination.total).to.be.above(700);",
                  "});",
                  "pm.test(\"Tri par date decroissante\", () => {",
                  "  const dates = corps.donnees.map(v => v.date_vente);",
                  "  pm.expect(dates).to.eql([...dates].sort().reverse());",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/ventes?page=1&limite=5",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "ventes"
              ],
              "query": [
                {
                  "key": "page",
                  "value": "1"
                },
                {
                  "key": "limite",
                  "value": "5"
                }
              ]
            }
          }
        },
        {
          "name": "Filtrer par client, paiement et periode",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Statut 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"Tous les resultats respectent les filtres\", () => {",
                  "  pm.response.json().donnees.forEach(v => {",
                  "    pm.expect(v.code_client).to.eql(\"CLI-0012\");",
                  "    pm.expect(v.mode_paiement).to.eql(\"MOBILE_MONEY\");",
                  "  });",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/ventes?code_client=CLI-0012&mode_paiement=mobile_money&date_debut=2026-10-01T00:00:00Z&date_fin=2026-10-14T23:59:59Z",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "ventes"
              ],
              "query": [
                {
                  "key": "code_client",
                  "value": "CLI-0012"
                },
                {
                  "key": "mode_paiement",
                  "value": "mobile_money"
                },
                {
                  "key": "date_debut",
                  "value": "2026-10-01T00:00:00Z"
                },
                {
                  "key": "date_fin",
                  "value": "2026-10-14T23:59:59Z"
                }
              ]
            }
          }
        },
        {
          "name": "Filtrer par montant et trier",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Statut 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"Montants >= 100000, ordre decroissant\", () => {",
                  "  const m = pm.response.json().donnees.map(v => v.montant_net);",
                  "  m.forEach(x => pm.expect(x).to.be.at.least(100000));",
                  "  pm.expect(m).to.eql([...m].sort((a, b) => b - a));",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/ventes?montant_min=100000&tri=-montant_net",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "ventes"
              ],
              "query": [
                {
                  "key": "montant_min",
                  "value": "100000"
                },
                {
                  "key": "tri",
                  "value": "-montant_net"
                }
              ]
            }
          }
        },
        {
          "name": "Ventes chargees par l'ETL",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Statut 200\", () => pm.response.to.have.status(200));",
                  "pm.collectionVariables.set(\"reference_etl\", pm.response.json().donnees[0].reference);"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/ventes?source=ETL&limite=1&tri=reference",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "ventes"
              ],
              "query": [
                {
                  "key": "source",
                  "value": "ETL"
                },
                {
                  "key": "limite",
                  "value": "1"
                },
                {
                  "key": "tri",
                  "value": "reference"
                }
              ]
            }
          }
        },
        {
          "name": "Consulter une vente chargee par l'ETL",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Statut 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"Tracabilite ETL\", () => {",
                  "  const v = pm.response.json();",
                  "  pm.expect(v.source).to.eql(\"ETL\");",
                  "  pm.expect(v.etl).to.include.keys(\"hash\", \"run_id\", \"fichier\", \"ligne\");",
                  "  pm.expect(v.montant_net).to.eql(v.montant_brut - v.montant_remise);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/ventes/{{reference_etl}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "ventes",
                "{{reference_etl}}"
              ]
            }
          }
        },
        {
          "name": "Statistiques",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Statut 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"Indicateurs presents\", () => {",
                  "  const s = pm.response.json();",
                  "  pm.expect(s.devise).to.eql(\"XOF\");",
                  "  pm.expect(s.nombre_ventes).to.be.above(0);",
                  "  pm.expect(s.par_mode_paiement).to.be.an(\"array\").that.is.not.empty;",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/ventes/statistiques",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "ventes",
                "statistiques"
              ]
            }
          }
        }
      ]
