# Copier vers .env pour surcharger les valeurs par defaut de docker-compose.yml.

# Ports exposes sur la machine hote
API_PORT=3000
AIRFLOW_PORT=8080
KIBANA_PORT=5601
ES_PORT=9200
MONGO_PORT=27017

# MongoDB
MONGO_DB=ventes_db
MONGO_ROOT_USER=admin
MONGO_ROOT_PASSWORD=admin_mdp
MONGO_API_USER=api_ventes
MONGO_API_PASSWORD=api_ventes_mdp
MONGO_ETL_USER=etl_airflow
MONGO_ETL_PASSWORD=etl_airflow_mdp

# Airflow
AIRFLOW_ADMIN_USER=admin
AIRFLOW_ADMIN_PASSWORD=admin
AIRFLOW_DB_PASSWORD=airflow
AIRFLOW_SECRET_KEY=ventes-groupe4-secret
# Cle Fernet de chiffrement des connexions (generer avec :
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())")
AIRFLOW_FERNET_KEY=

# Pile ELK
ELK_VERSION=8.15.3
